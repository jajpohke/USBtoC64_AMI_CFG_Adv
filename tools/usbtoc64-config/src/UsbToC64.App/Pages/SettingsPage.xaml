<UserControl x:Class="UsbToC64.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:UsbToC64.App.Controls"
             xmlns:l="clr-namespace:UsbToC64.App.Loc">
    <DockPanel Margin="24,18,24,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="LoadBtn" Content="{l:T set.load}" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,8,0" Click="Load_Click" />
                <ui:Button x:Name="ApplyBtn" Content="{l:T set.apply}" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Margin="0,0,8,0" Click="Apply_Click" />
                <ui:Button x:Name="FactoryBtn" Content="{l:T set.factory}" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Click="Factory_Click" />
            </StackPanel>
            <TextBlock Text="{l:T set.title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="Result" Style="{StaticResource Hint}" />
        </DockPanel>
        <c:OperationPanel x:Name="OpPanel" DockPanel.Dock="Bottom" Margin="0,10,0,0" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Margin="0,0,0,12" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:T set.lang.title}" Style="{StaticResource CardTitle}" />
                        <c:LanguagePicker HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{l:T set.lang.hint}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,12" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:T set.mode.title}" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{l:T set.mode.active}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ModeText" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox x:Name="Invert" Content="{l:T set.invert}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,8"
                                   Text="{l:T set.invert.hint}" />
                        <CheckBox x:Name="DevAmiga" Content="{l:T set.devAmiga}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,12" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:T set.dev.title}" Style="{StaticResource CardTitle}" />
                        <CheckBox x:Name="DevMode" Content="{l:T set.dev.enable}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0"
                                   Text="{l:T set.dev.hint}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:T set.mem.title}" Style="{StaticResource CardTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{l:T set.mem.mouse}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MemMouse" Text="—" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="0" Grid.Column="2" x:Name="ClearMouse" Content="{l:T set.mem.clear}" />
                            <TextBlock Grid.Row="1" Text="{l:T set.mem.pad}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MemPad" Text="—" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="ClearPad" Content="{l:T set.mem.clear}" />
                            <TextBlock Grid.Row="2" Text="{l:T set.mem.led}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MemLed" Text="—" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="2" Grid.Column="2" x:Name="ClearLed" Content="{l:T set.mem.clear}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="{l:T set.mem.hint}" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
