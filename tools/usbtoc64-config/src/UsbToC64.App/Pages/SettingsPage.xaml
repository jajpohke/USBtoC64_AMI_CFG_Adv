<UserControl x:Class="UsbToC64.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:UsbToC64.App.Controls">
    <DockPanel Margin="24,18,24,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="LoadBtn" Content="Leggi dall'adattatore" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,8,0" Click="Load_Click" />
                <ui:Button x:Name="ApplyBtn" Content="Applica e riavvia" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Margin="0,0,8,0" Click="Apply_Click" />
                <ui:Button x:Name="FactoryBtn" Content="Factory reset…" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Click="Factory_Click" />
            </StackPanel>
            <TextBlock Text="Impostazioni" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="Result" Style="{StaticResource Hint}" />
        </DockPanel>
        <c:OperationPanel x:Name="OpPanel" DockPanel.Dock="Bottom" Margin="0,10,0,0" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Margin="0,0,0,12" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Modalità C64/Amiga" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Modalità attiva: " VerticalAlignment="Center" />
                            <TextBlock x:Name="ModeText" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox x:Name="Invert" Content="Inverti la logica dello switch C64/Amiga" />
                        <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,8"
                                   Text="Utile se lo switch della scheda è montato al contrario. La modalità resta decisa dallo switch: cambia solo quale posizione vale C64 e quale Amiga." />
                        <CheckBox x:Name="DevAmiga" Content="Forza la modalità Amiga (solo con la Developer Mode attiva)" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,12" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Developer Mode" Style="{StaticResource CardTitle}" />
                        <CheckBox x:Name="DevMode" Content="Attiva la Developer Mode" />
                        <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0"
                                   Text="Dopo il riavvio la seriale passa ai pin 43/44 (adattatore USB-seriale esterno) e la USB-C fa da host per il pad: da qui non sarà più possibile comunicare con l'adattatore. Per disattivarla serve il terminale sui pin 43/44 («devmode off») oppure il factory reset con il tasto BOOT." />
                    </StackPanel>
                </ui:Card>

                <ui:Card VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Memoria dell'adattatore" Style="{StaticResource CardTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Impostazioni mouse" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MemMouse" Text="—" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="0" Grid.Column="2" x:Name="ClearMouse" Content="Cancella" />
                            <TextBlock Grid.Row="1" Text="Profilo gamepad" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MemPad" Text="—" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="ClearPad" Content="Cancella" />
                            <TextBlock Grid.Row="2" Text="Colori LED" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MemLed" Text="—" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="2" Grid.Column="2" x:Name="ClearLed" Content="Cancella" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="Le modifiche (switch, Developer Mode, cancellazioni) vengono applicate con «Applica e riavvia». Il factory reset cancella tutto." />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
