<UserControl x:Class="UsbToC64.App.Pages.LedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:UsbToC64.App.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="ColorItem">
            <StackPanel Orientation="Horizontal">
                <Border Width="18" Height="18" CornerRadius="4" Background="{Binding Brush}" Margin="0,0,10,0"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="24,18,24,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="LoadBtn" Content="Leggi dall'adattatore" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,8,0" Click="Load_Click" />
                <ui:Button x:Name="ResetBtn" Content="Ripristina predefiniti" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,0,8,0" Click="Reset_Click" />
                <ui:Button x:Name="SaveBtn" Content="Salva sull'adattatore" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Click="Save_Click" />
            </StackPanel>
            <TextBlock Text="LED" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="Result" Style="{StaticResource Hint}" />
        </DockPanel>
        <c:OperationPanel x:Name="OpPanel" DockPanel.Dock="Bottom" Margin="0,10,0,0" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <ui:Card Grid.Column="0" Margin="0,0,12,0" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Colori" Style="{StaticResource CardTitle}" />
                    <ItemsControl x:Name="Slots">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="200" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding Palette}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                              ItemTemplate="{StaticResource ColorItem}" Width="220" HorizontalAlignment="Left" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Il firmware memorizza solo questi colori, con luminosità ridotta. «Spento» non accende il LED per quell'evento." />
                </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="1" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Hardware" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Formato del chip LED" Margin="0,0,0,6" />
                    <ComboBox x:Name="Format" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="GRB (WS2812B standard)" />
                        <ComboBoxItem Content="RGB (formato alternativo)" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14" Text="Se rosso e verde risultano scambiati, cambia formato." />
                    <CheckBox x:Name="Mono" Content="Disattiva i colori multipli (monocromatico)" />
                    <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0" Text="Il LED usa solo il colore di riposo della modalità attiva." />
                </StackPanel>
            </ui:Card>
        </Grid>
    </DockPanel>
</UserControl>
