<UserControl x:Class="UsbToC64.App.Pages.LedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:UsbToC64.App.Controls"
             xmlns:l="clr-namespace:UsbToC64.App.Loc">
    <UserControl.Resources>
        <DataTemplate x:Key="ColorItem">
            <StackPanel Orientation="Horizontal">
                <Border Width="18" Height="18" CornerRadius="4" Background="{Binding Brush}" Margin="0,0,10,0"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="24,18,24,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="LoadBtn" Content="{l:T led.load}" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,8,0" Click="Load_Click" />
                <ui:Button x:Name="ResetBtn" Content="{l:T led.reset}" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,0,8,0" Click="Reset_Click" />
                <ui:Button x:Name="SaveBtn" Content="{l:T led.save}" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Click="Save_Click" />
            </StackPanel>
            <TextBlock Text="{l:T led.title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="Result" Style="{StaticResource Hint}" />
        </DockPanel>
        <c:OperationPanel x:Name="OpPanel" DockPanel.Dock="Bottom" Margin="0,10,0,0" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <ui:Card Grid.Column="0" Margin="0,0,12,0" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{l:T led.colors.title}" Style="{StaticResource CardTitle}" />
                    <ItemsControl x:Name="Slots">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="200" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding Palette}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                              ItemTemplate="{StaticResource ColorItem}" Width="220" HorizontalAlignment="Left" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="{l:T led.colors.hint}" />
                </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="1" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{l:T led.hw.title}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{l:T led.format}" Margin="0,0,0,6" />
                    <ComboBox x:Name="Format" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="{l:T led.grb}" />
                        <ComboBoxItem Content="{l:T led.rgb}" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14" Text="{l:T led.format.hint}" />
                    <CheckBox x:Name="Mono" Content="{l:T led.mono}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0" Text="{l:T led.mono.hint}" />
                </StackPanel>
            </ui:Card>
        </Grid>
    </DockPanel>
</UserControl>
