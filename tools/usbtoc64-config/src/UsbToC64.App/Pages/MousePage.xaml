<UserControl x:Class="UsbToC64.App.Pages.MousePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:UsbToC64.App.Controls">
    <DockPanel Margin="24,18,24,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="LoadBtn" Content="Leggi dall'adattatore" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,8,0" Click="Load_Click" />
                <ui:Button x:Name="DefaultBtn" Content="Valori predefiniti" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,0,8,0" Click="Default_Click" />
                <ui:Button x:Name="SaveBtn" Content="Salva sull'adattatore" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Click="Save_Click" />
            </StackPanel>
            <TextBlock Text="Mouse" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="Result" Style="{StaticResource Hint}" />
        </DockPanel>
        <c:OperationPanel x:Name="OpPanel" DockPanel.Dock="Bottom" Margin="0,10,0,0" />

        <StackPanel>
            <ui:Card Margin="0,0,0,12" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Velocità del puntatore" Style="{StaticResource CardTitle}" />
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Amiga (quadratura)" Width="210" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" x:Name="AmigaVal" Width="30" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Slider x:Name="AmigaSpeed" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                Margin="0,0,12,0" ValueChanged="Speed_ValueChanged" />
                    </DockPanel>
                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="C64 (1351 analogico)" Width="210" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" x:Name="C64Val" Width="30" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Slider x:Name="C64Speed" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                Margin="0,0,12,0" ValueChanged="Speed_ValueChanged" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="Da 1 (lento) a 5 (veloce). Il valore predefinito è 3." />
                </StackPanel>
            </ui:Card>
            <ui:Card VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Estensioni del protocollo" Style="{StaticResource CardTitle}" />
                    <CheckBox x:Name="Wheel" Content="Rotella del mouse (C64/Amiga)" />
                    <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,12"
                               Text="Può non funzionare con i mouse più vecchi (protocollo BOOT a 3 byte). Sull'Amiga emula il click centrale, sul C64 usa lo standard Micromys." />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Temporizzazione POT (solo mouse C64)" Width="260" VerticalAlignment="Center" />
                        <ComboBox x:Name="Timing" Width="180" HorizontalAlignment="Left">
                            <ComboBoxItem Content="PAL (predefinito)" />
                            <ComboBoxItem Content="NTSC" />
                        </ComboBox>
                    </DockPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </DockPanel>
</UserControl>
