<UserControl x:Class="UsbToC64.App.Pages.TerminalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:UsbToC64.App.Loc">
    <DockPanel Margin="24,18,24,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="StateChip" CornerRadius="12" Padding="10,3" Margin="0,0,10,0" VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <TextBlock x:Name="StateText" FontSize="12" Text="{l:T term.state.disconnected}" />
                </Border>
                <ui:Button x:Name="ConnectBtn" Content="{l:T term.connect}" Icon="{ui:SymbolIcon PlugConnected24}" Margin="0,0,8,0" Click="Connect_Click" />
                <ui:Button Content="{l:T term.clear}" Icon="{ui:SymbolIcon Broom24}" Margin="0,0,8,0" Click="Clear_Click" />
                <ui:Button Content="{l:T term.save}" Icon="{ui:SymbolIcon Save24}" Click="Save_Click" />
            </StackPanel>
            <TextBlock Text="{l:T term.title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center" Text="{l:T term.hint.eol}" />
            <WrapPanel x:Name="Quick" VerticalAlignment="Center">
                <TextBlock Text="{l:T term.quick}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
            </WrapPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{l:T term.command}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ui:Button x:Name="SendBtn" DockPanel.Dock="Right" Content="{l:T term.send}" Icon="{ui:SymbolIcon Send24}" Appearance="Primary" Margin="8,0,0,0" Click="Send_Click" />
            <ui:TextBox x:Name="Input" FontFamily="{StaticResource MonoFont}" FontSize="13" PreviewKeyDown="Input_PreviewKeyDown" />
        </DockPanel>

        <TextBox x:Name="Output" Style="{StaticResource Mono}" />
    </DockPanel>
</UserControl>
