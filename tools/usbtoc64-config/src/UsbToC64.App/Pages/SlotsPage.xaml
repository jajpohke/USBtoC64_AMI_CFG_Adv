<UserControl x:Class="UsbToC64.App.Pages.SlotsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:UsbToC64.App.Loc">
    <DockPanel Margin="24,18,24,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <ui:Button x:Name="RefreshBtn" DockPanel.Dock="Right" Content="{l:T slots.refresh}" Icon="{ui:SymbolIcon ArrowSync24}"
                       VerticalAlignment="Center" Click="Refresh_Click" />
            <TextBlock Text="{l:T slots.title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14" Text="{l:T slots.intro}" />
        <TextBlock x:Name="StateText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,14" Visibility="Collapsed" />
        <TextBlock x:Name="LastResult" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="List" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
