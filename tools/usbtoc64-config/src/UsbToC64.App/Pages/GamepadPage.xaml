<UserControl x:Class="UsbToC64.App.Pages.GamepadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:UsbToC64.App.Controls"
             xmlns:l="clr-namespace:UsbToC64.App.Loc">
    <DockPanel Margin="24,18,24,16">

        <!-- Title and profile actions -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="ProposeBtn" Content="{l:T gp.propose}" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,0,8,0" Click="Propose_Click" />
                <ui:Button x:Name="ImportBtn" Content="{l:T gp.import}" Icon="{ui:SymbolIcon ArrowImport24}" Margin="0,0,8,0" Click="Import_Click" />
                <ui:Button x:Name="ExportBtn" Content="{l:T gp.export}" Icon="{ui:SymbolIcon ArrowExport24}" Click="Export_Click" />
            </StackPanel>
            <TextBlock Text="{l:T gp.title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Pad selection -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" x:Name="PadHint" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       Text="{l:T gp.hint.press}" />
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="PadCombo" Width="380" SelectionChanged="PadCombo_SelectionChanged" />
                <ui:Button x:Name="RefreshBtn" Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,12,0" ToolTip="{l:T gp.refresh.tip}" Click="Refresh_Click" />
                <Border x:Name="KindChip" CornerRadius="12" Padding="10,3" Margin="0,0,8,0" VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <TextBlock x:Name="KindText" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <Border x:Name="CountChip" CornerRadius="12" Padding="10,3" VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <TextBlock x:Name="CountText" FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Footer: view switch, last result, read/write -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="LastResult" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="380" TextTrimming="CharacterEllipsis" />
                <ui:Button x:Name="ReadBtn" Content="{l:T gp.read}" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,8,0" Click="Read_Click" />
                <ui:Button x:Name="WriteBtn" Content="{l:T gp.write}" Icon="{ui:SymbolIcon ArrowUpload24}" Appearance="Primary" Click="Write_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="ViewTable" Content="{l:T gp.view.preview}" IsChecked="True" GroupName="view" Margin="0,0,16,0" Checked="View_Checked" />
                <RadioButton x:Name="ViewRules" Content="{l:T gp.view.rules}" GroupName="view" Margin="0,0,16,0" Checked="View_Checked" />
                <RadioButton x:Name="ViewJson" Content="JSON" GroupName="view" Checked="View_Checked" />
            </StackPanel>
        </DockPanel>

        <c:OperationPanel x:Name="OpPanel" DockPanel.Dock="Bottom" Margin="0,10,0,0" />

        <!-- Main area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,14,0">
                <DataGrid x:Name="Table" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36"
                          RowBackground="Transparent" AlternatingRowBackground="Transparent"
                          HorizontalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Opacity" Value="{Binding RowOpacity}" />
                            <Setter Property="ToolTip" Value="{Binding Note}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background" Value="#3346B55A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding Glyph}" Width="34" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:T gp.col.control}" Binding="{Binding Name}" Width="1.4*" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:T gp.col.type}" Binding="{Binding Kind}" Width="0.8*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Byte" Binding="{Binding Byte}" Width="0.5*" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:T gp.col.bits}" Binding="{Binding Bits}" Width="0.8*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="{l:T gp.col.action}" Width="1.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanEdit}" Padding="8,2" MinHeight="28" Margin="0,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T gp.col.state}" Binding="{Binding State}" Width="0.8*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBox x:Name="RulesBox" Style="{StaticResource Mono}" Visibility="Collapsed" />
                <TextBox x:Name="JsonBox" Style="{StaticResource Mono}" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Visibility="Collapsed"
                           Text="{l:T gp.empty}" />
            </Grid>

            <DockPanel Grid.Column="1">
                <ui:Card DockPanel.Dock="Top" Margin="0,0,0,12" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:T db9.title}" Style="{StaticResource CardTitle}" />
                        <c:Db9Preview x:Name="Preview" />
                    </StackPanel>
                </ui:Card>
                <ui:Card VerticalContentAlignment="Top">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{l:T gp.issues.title}" Style="{StaticResource CardTitle}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="IssuesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Foreground="{Binding Brush}" FontWeight="Bold" Width="20" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </ui:Card>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
