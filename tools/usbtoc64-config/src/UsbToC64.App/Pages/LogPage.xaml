<UserControl x:Class="UsbToC64.App.Pages.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DockPanel Margin="24,20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="Copia" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,0" Click="Copy_Click" />
                <ui:Button Content="Salva su file…" Icon="{ui:SymbolIcon Save24}" Margin="0,0,8,0" Click="Save_Click" />
                <ui:Button Content="Pulisci" Icon="{ui:SymbolIcon Broom24}" Click="Clear_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Registro" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="Tutto quello che il programma ha scambiato con l'adattatore in questa sessione: comandi (→), risposte (←), aggiornamenti del firmware." />
            </StackPanel>
        </DockPanel>
        <TextBox x:Name="LogBox" Style="{StaticResource Mono}" />
    </DockPanel>
</UserControl>
