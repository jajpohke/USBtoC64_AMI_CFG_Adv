<UserControl x:Class="UsbToC64.App.Pages.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:UsbToC64.App.Loc">
    <DockPanel Margin="24,20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="{l:T log.copy}" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,0" Click="Copy_Click" />
                <ui:Button Content="{l:T log.save}" Icon="{ui:SymbolIcon Save24}" Margin="0,0,8,0" Click="Save_Click" />
                <ui:Button Content="{l:T log.clear}" Icon="{ui:SymbolIcon Broom24}" Click="Clear_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{l:T log.title}" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="{l:T log.hint}" />
            </StackPanel>
        </DockPanel>
        <TextBox x:Name="LogBox" Style="{StaticResource Mono}" />
    </DockPanel>
</UserControl>
