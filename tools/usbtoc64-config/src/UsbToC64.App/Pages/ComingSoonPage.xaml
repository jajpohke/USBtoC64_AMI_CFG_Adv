<UserControl x:Class="UsbToC64.App.Pages.ComingSoonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
        <ui:Card>
            <StackPanel>
                <TextBlock Text="In arrivo nella prossima tappa" Style="{StaticResource CardTitle}" />
                <TextBlock x:Name="DescText" Style="{StaticResource Hint}" FontSize="13" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                           Text="Nel frattempo queste impostazioni si gestiscono dalle pagine del configuratore web." />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>
