<UserControl x:Class="UsbToC64.App.Pages.SimplePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:UsbToC64.App.Controls">
    <UserControl.Resources>
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="StepNum" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="820" Margin="32,24,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Configura il tuo pad" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" FontSize="14" Margin="0,4,0,0"
                           Text="Tre passi: adattatore, pad, salva. Poi collega l'adattatore al C64/Amiga e gioca." />
            </StackPanel>

            <!-- 1. Adapter -->
            <Border Grid.Row="1" Style="{StaticResource StepCard}">
                <DockPanel>
                    <Border x:Name="Num1" DockPanel.Dock="Left" Style="{StaticResource StepNum}">
                        <TextBlock x:Name="Num1Text" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="1 · Adattatore" Style="{StaticResource StepTitle}" />
                        <TextBlock x:Name="AdapterState" TextWrapping="Wrap" FontSize="14" />
                        <TextBlock x:Name="AdapterHint" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:Button x:Name="AdapterAction" Appearance="Primary" Visibility="Collapsed" Margin="0,0,8,0" Click="AdapterAction_Click" />
                            <ui:Button x:Name="AdapterFile" Content="Installa da file…" Visibility="Collapsed" Margin="0,0,8,0" Click="AdapterFile_Click" />
                            <ui:Button x:Name="AdapterRetry" Content="Riprova" Icon="{ui:SymbolIcon ArrowSync24}" Visibility="Collapsed" Click="AdapterRetry_Click" />
                            <ui:ProgressRing x:Name="AdapterRing" IsIndeterminate="True" Width="20" Height="20" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. Pad -->
            <Border Grid.Row="2" Style="{StaticResource StepCard}">
                <DockPanel>
                    <Border x:Name="Num2" DockPanel.Dock="Left" Style="{StaticResource StepNum}">
                        <TextBlock x:Name="Num2Text" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="2 · Pad da configurare" Style="{StaticResource StepTitle}" />
                        <DockPanel Margin="0,2,0,10">
                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,0,0" ToolTip="Aggiorna l'elenco dei pad" Click="RefreshPads_Click" />
                            <ComboBox x:Name="PadCombo" MinHeight="36" SelectionChanged="PadCombo_SelectionChanged" />
                        </DockPanel>
                        <DockPanel x:Name="PreviewRow">
                            <Viewbox DockPanel.Dock="Left" Height="150" Margin="0,0,18,0" Stretch="Uniform">
                                <c:Db9Preview x:Name="Preview" Width="190" />
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Hint}" FontSize="13" Text="Prova il pad: qui vedi cosa riceverà il C64/Amiga su porta DB9." />
                                <TextBlock x:Name="PadState" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="13.5" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 3. Save -->
            <Border Grid.Row="3" Style="{StaticResource StepCard}">
                <DockPanel>
                    <Border x:Name="Num3" DockPanel.Dock="Left" Style="{StaticResource StepNum}">
                        <TextBlock x:Name="Num3Text" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="3 · Salva" Style="{StaticResource StepTitle}" />
                        <ui:Button x:Name="SaveBtn" Appearance="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Height="56" FontSize="18" FontWeight="Bold" Icon="{ui:SymbolIcon ArrowUpload24}"
                                   Content="Salva su USBtoC64" Click="Save_Click" />
                        <StackPanel x:Name="Saving" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" />
                            <TextBlock Text="Scrittura e verifica in corso: non scollegare l'adattatore…" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="SaveHint" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="Il profilo viene scritto sull'adattatore e riletto per verifica." />
                        <Border x:Name="DoneCard" CornerRadius="8" Padding="14,10" Margin="0,10,0,0" Visibility="Collapsed"
                                Background="#1F3328" BorderBrush="#2F5A3A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="✔  Fatto! Profilo salvato e verificato." FontWeight="SemiBold" Foreground="#6CCB5F" />
                                <TextBlock Text="Scollega l'adattatore dal PC e collegalo al C64/Amiga insieme al pad." Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SaveError" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#FF6B6B" Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Grid.Row="5" Margin="0,8,0,0">
                <ui:Button DockPanel.Dock="Right" Content="Configurazione avanzata →" Appearance="Transparent"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" Click="Advanced_Click" />
                <CheckBox x:Name="StartAdvanced" Content="Apri sempre in modalità avanzata" VerticalAlignment="Center"
                          Checked="StartAdvanced_Changed" Unchecked="StartAdvanced_Changed" />
            </DockPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
