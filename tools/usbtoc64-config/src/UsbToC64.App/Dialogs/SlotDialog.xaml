<ui:FluentWindow x:Class="UsbToC64.App.Dialogs.SlotDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:UsbToC64.App.Loc"
                 Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round" ShowInTaskbar="False">
    <StackPanel>
        <ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="24,4,24,20">
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="Info" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <StackPanel x:Name="SlotPanel" Margin="0,16,0,0">
                <TextBlock Text="{l:T sd.slot}" Margin="0,0,0,6" />
                <ComboBox x:Name="SlotCombo" SelectionChanged="SlotCombo_SelectionChanged" />
                <TextBlock x:Name="SlotWarning" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#FFB454" Visibility="Collapsed" />
            </StackPanel>

            <TextBlock Text="{l:T sd.label}" Margin="0,16,0,6" />
            <ui:TextBox x:Name="LabelBox" MaxLength="24" TextChanged="LabelBox_TextChanged" PlaceholderText="WebConfigured" />
            <TextBlock x:Name="Counter" Style="{StaticResource Hint}" HorizontalAlignment="Right" Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button x:Name="OkBtn" Appearance="Primary" MinWidth="110" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
                <ui:Button Content="{l:T sd.cancel}" MinWidth="110" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
