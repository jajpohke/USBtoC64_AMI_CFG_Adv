<UserControl x:Class="UsbToC64.App.Controls.LanguagePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:UsbToC64.App.Loc">
    <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Symbol="Globe24" Margin="0,0,8,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ComboBox x:Name="Combo" MinWidth="130" ToolTip="{l:T lang.tooltip}" SelectionChanged="Combo_SelectionChanged" />
    </StackPanel>
</UserControl>
