<UserControl x:Class="UsbToC64.App.Controls.ProgressPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:UsbToC64.App.Loc"
             Visibility="Collapsed">
    <StackPanel Margin="0,10,0,0">
        <!-- Shown while writing: the one thing that must not happen -->
        <Border x:Name="Warning" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}" BorderThickness="1">
            <DockPanel>
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning24" Filled="True" FontSize="20" Margin="0,0,10,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{l:T prog.warning}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </Border>

        <DockPanel Margin="0,0,0,6">
            <TextBlock x:Name="PercentText" DockPanel.Dock="Right" FontWeight="SemiBold" />
            <TextBlock x:Name="PhaseText" TextWrapping="Wrap" />
        </DockPanel>
        <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100" />

        <DockPanel Margin="0,6,0,0">
            <ui:Button x:Name="CopyBtn" DockPanel.Dock="Right" Content="{l:T prog.copy}" Icon="{ui:SymbolIcon Copy24}"
                       Appearance="Transparent" Padding="8,2" Visibility="Collapsed" Click="Copy_Click" />
            <ui:Button x:Name="DetailsBtn" Appearance="Transparent" Padding="0,2" HorizontalAlignment="Left"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Click="Details_Click" />
        </DockPanel>
        <TextBox x:Name="Box" Style="{StaticResource Mono}" Height="150" Margin="0,4,0,0" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
