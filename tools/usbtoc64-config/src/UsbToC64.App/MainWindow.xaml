<ui:FluentWindow x:Class="UsbToC64.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="USBtoC64 Config" Width="1360" Height="860" MinWidth="1040" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="USBtoC64 Config" />

        <!-- Simple mode (default at start-up) -->
        <ContentControl x:Name="SimpleHost" Grid.Row="1" />

        <!-- Advanced mode -->
        <Grid x:Name="AdvancedRoot" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Side navigation -->
            <DockPanel Grid.Column="0" Margin="8,4,8,8">
                <ui:Button DockPanel.Dock="Bottom" Content="← Modalità semplice" Appearance="Transparent" HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="Simple_Click" />
                <Border DockPanel.Dock="Bottom" Padding="12,10" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AdapterDot" Width="9" Height="9" Margin="0,0,8,0" Fill="Gray" VerticalAlignment="Center" />
                            <TextBlock x:Name="AdapterTitle" Text="Adattatore: verifica…" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="AdapterLine1" Style="{StaticResource Hint}" Margin="17,4,0,0" />
                        <TextBlock x:Name="AdapterLine2" Style="{StaticResource Hint}" Margin="17,2,0,0" />
                        <ui:Button x:Name="AdapterCheck" Content="Controlla" Icon="{ui:SymbolIcon ArrowSync24}"
                                   Margin="13,8,0,0" Padding="10,4" Click="AdapterCheck_Click" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="Nav" DockPanel.Dock="Top" BorderThickness="0" Background="Transparent"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Tag="gamepad">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="XboxController24" Margin="0,0,12,0" /><TextBlock Text="Gamepad" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="mouse">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="CursorClick24" Margin="0,0,12,0" /><TextBlock Text="Mouse" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="led">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Lightbulb24" Margin="0,0,12,0" /><TextBlock Text="LED" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" /><TextBlock Text="Impostazioni" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="firmware">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowUpload24" Margin="0,0,12,0" /><TextBlock Text="Firmware" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="terminal">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="WindowConsole20" Margin="0,0,12,0" /><TextBlock Text="Terminale" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="log">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="TextBulletListLtr24" Margin="0,0,12,0" /><TextBlock Text="Registro" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <!-- Content -->
            <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <DockPanel>
                    <ui:InfoBar x:Name="FirmwareBar" DockPanel.Dock="Top" Margin="20,14,20,0" IsOpen="False" IsClosable="True"
                                Severity="Warning" Title="Firmware" />
                    <ContentControl x:Name="Host" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
