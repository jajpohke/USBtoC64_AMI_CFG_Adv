<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>USBtoC64Config</AssemblyName>
    <RootNamespace>UsbToC64.Gui</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsbToC64.Core\UsbToC64.Core.csproj" />
    <ProjectReference Include="..\UsbToC64.Input\UsbToC64.Input.csproj" />
    <ProjectReference Include="..\UsbToC64.Device\UsbToC64.Device.csproj" />
  </ItemGroup>

</Project>
